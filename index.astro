      padding: 0;
      font-family: Segoe UI, Tahoma, Geneva, Verdana, sans-serif;
      display: flex;
    }
    .container[data-astro-cid-lcdefpme] {
      text-align: center;
      max-width: 800px;
      padding: 20px;
    }
    h1[data-astro-cid-lcdefpme] {
      background: linear-gradient(90deg, #4ade80, #38bdf8);
      -webkit-text-fill-color: transparent;
      -webkit-background-clip: text;
      margin-bottom: 10px;
      font-size: 3.5rem;
    }
    p[data-astro-cid-lcdefpme] {
      color: #a1a1aa;
      margin-bottom: 30px;
