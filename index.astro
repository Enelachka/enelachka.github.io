      border: 1px solid #4ade804d;
      border-radius: 16px;
      padding: 20px 30px;
      display: inline-block;
      box-shadow: 0 10px 30px #00000080;
    }
    .ip-text[data-astro-cid-lcdefpme] {
      color: #f4f4f5;
      letter-spacing: .5px;
      margin-bottom: 15px;
      font-size: 1.4rem;
      font-weight: 700;
    }
    .btn[data-astro-cid-lcdefpme] {
      color: #fff;
      cursor: pointer;
      background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
      border: none;
      border-radius: 10px;
      padding: 12px 28px;
      font-size: 1.1rem;
      font-weight: 700;
      transition: all .2s;
      box-shadow: 0 4px 15px #22c55e66;
    }
    .btn[data-astro-cid-lcdefpme]:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 20px #22c55e99;
    }
    .features[data-astro-cid-lcdefpme] {
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-top: 50px;
      display: flex;
    }
