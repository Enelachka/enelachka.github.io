      text-align: left;
      background: #18181bcc;
      border: 1px solid #27272a;
      border-radius: 12px;
      width: 200px;
      padding: 20px;
    }
    .feature-box[data-astro-cid-lcdefpme] h3[data-astro-cid-lcdefpme] {
      color: #4ade80;
      margin-top: 0;
      font-size: 1.1rem;
    }
    .feature-box[data-astro-cid-lcdefpme] p[data-astro-cid-lcdefpme] {
      color: #71717a;
      margin-bottom: 0;
      font-size: .95rem;
    }
  </style>
</head>
<body data-astro-cid-lcdefpme>
  <div class="container" data-astro-cid-lcdefpme>
    <h1 data-astro-cid-lcdefpme>⚔️ VinelandSMP ⚔️</h1>
